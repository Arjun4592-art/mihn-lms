rules_version = '2';

// All certificate data is read and written exclusively through the Next.js
// server (Firebase Admin SDK in lib/firebaseAdmin.ts + lib/certificates.ts),
// which bypasses these rules entirely. Nothing in the browser talks to
// Firestore directly, so we deny all direct client access as a safety net —
// this way even if someone gets the client Firebase config, they can't read
// or write certificate data straight from the browser console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
